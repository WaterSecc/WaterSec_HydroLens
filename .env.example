# Hugging Face Inference Providers
# Copy this file to .env and replace the placeholder token locally.
# Never commit the real .env file or a valid token.
HF_TOKEN=hf_replace_with_your_token
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct:nscale
HF_BASE_URL=https://router.huggingface.co/v1

# Hotel-generation gateway:
# - huggingface-llama uses remote Llama inference.
# - local-no-ml uses the deterministic seeded hotel planner.
HYDROLENS_AI_GATEWAY_MODE=huggingface-llama
HYDROLENS_AI_VERSION=llama-3.1-huggingface

# Temporary in-memory Digital Twin sessions
HYDROLENS_SESSION_TTL=PT60M
HYDROLENS_SESSION_CLEANUP_INTERVAL=PT5M
HYDROLENS_MAX_SESSIONS=100

# Security and browser access
WATERSEC_PUBLIC_API=true
WATERSEC_API_USERNAME=watersec
WATERSEC_API_PASSWORD=replace-with-a-strong-password
HYDROLENS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
